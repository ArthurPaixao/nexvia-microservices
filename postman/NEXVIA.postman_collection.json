{
  "info": {
    "name": "NEXVIA",
    "description": "NEXVIA - Global Solution 2026.2 (Microservice and Web Engineering & IT Services).\n\nTodas as requisições passam pelo API Gateway ({{baseUrl}}). Rode as pastas 1 a 5 em ordem, com o banco recém-criado (carga inicial do Flyway). A pasta 6 é manual: exige parar o ms-apoio.\n\nGuia completo: docs/GUIA_DE_TESTES.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "eurekaUrl",
      "value": "http://localhost:8761"
    },
    {
      "key": "pessoaCriadaId",
      "value": ""
    },
    {
      "key": "acionamentoCriadoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Infraestrutura",
      "description": "Eureka, Gateway, Swagger e Load Balancer.",
      "item": [
        {
          "name": "1.1 Eureka - servicos registrados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{eurekaUrl}}/eureka/apps"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"API-GATEWAY, MS-APOIO e MS-ALERTAS registrados\", () => { const t = pm.response.text(); [\"API-GATEWAY\",\"MS-APOIO\",\"MS-ALERTAS\"].forEach(s => pm.expect(t).to.include(s)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Swagger dinamico do Gateway (swagger-config)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs/swagger-config"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lista ms-apoio e ms-alertas\", () => { const n = pm.response.json().urls.map(u => u.name); pm.expect(n).to.include(\"ms-apoio\"); pm.expect(n).to.include(\"ms-alertas\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 OpenAPI do ms-apoio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ms-apoio/v3/api-docs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"titulo NEXVIA\", () => pm.expect(pm.response.json().info.title).to.include(\"NEXVIA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 OpenAPI do ms-alertas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ms-alertas/v3/api-docs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"titulo NEXVIA\", () => pm.expect(pm.response.json().info.title).to.include(\"NEXVIA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Load Balancer - porta da instancia do ms-apoio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ms-apoio/api/v1/pessoas/port",
            "description": "Com 2 instâncias do ms-apoio, execute várias vezes: a porta alterna."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mostra a porta\", () => pm.expect(pm.response.text()).to.include(\"porta\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - ms-apoio (CRUD)",
      "description": "CRUD completo de pessoas: GET, GET por ID, POST (201 + Location), PUT e DELETE.",
      "item": [
        {
          "name": "2.1 Listar pessoas (por prioridade)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ms-apoio/api/v1/pessoas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"5 pessoas da carga inicial\", () => pm.expect(pm.response.json().length).to.be.at.least(5));",
                  "pm.test(\"prioridade 1 primeiro\", () => pm.expect(pm.response.json()[0].prioridade).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Buscar pessoa por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ms-apoio/api/v1/pessoas/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"nome = Maria Aparecida dos Santos\", () => pm.expect(pm.response.json().nome).to.eql(\"Maria Aparecida dos Santos\"));",
                  "pm.test(\"statusSeguranca = CADASTRADA\", () => pm.expect(pm.response.json().statusSeguranca).to.eql(\"CADASTRADA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Cadastrar pessoa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ms-apoio/api/v1/pessoas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"José Ferreira\",\n  \"endereco\": \"Rua Nova, 10\",\n  \"bairro\": \"Vila Ribeirinha\",\n  \"necessidade\": \"Usa marca-passo, 90 anos\",\n  \"prioridade\": 1,\n  \"nomePadrinho\": \"Rita Ferreira\",\n  \"telefonePadrinho\": \"11912345678\",\n  \"consentimentoLgpd\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"header Location com a URI do recurso\", () => pm.expect(pm.response.headers.get(\"Location\")).to.match(/\\/api\\/v1\\/pessoas\\/\\d+$/));",
                  "pm.test(\"statusSeguranca = CADASTRADA\", () => pm.expect(pm.response.json().statusSeguranca).to.eql(\"CADASTRADA\"));",
                  "pm.collectionVariables.set(\"pessoaCriadaId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Atualizar pessoa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ms-apoio/api/v1/pessoas/{{pessoaCriadaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"José Ferreira\",\n  \"endereco\": \"Rua Nova, 12\",\n  \"bairro\": \"Vila Ribeirinha\",\n  \"necessidade\": \"Usa marca-passo, 90 anos\",\n  \"prioridade\": 2,\n  \"nomePadrinho\": \"Rita Ferreira\",\n  \"telefonePadrinho\": \"11912345678\",\n  \"consentimentoLgpd\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"prioridade = 2\", () => pm.expect(pm.response.json().prioridade).to.eql(2));",
                  "pm.test(\"endereco = Rua Nova, 12\", () => pm.expect(pm.response.json().endereco).to.eql(\"Rua Nova, 12\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Excluir pessoa",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/ms-apoio/api/v1/pessoas/{{pessoaCriadaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Buscar pessoa excluida (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ms-apoio/api/v1/pessoas/{{pessoaCriadaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"corpo no padrão CustomErrorDTO\", () => { const j = pm.response.json(); pm.expect(j).to.have.property(\"timestamp\"); pm.expect(j.status).to.eql(404); pm.expect(j).to.have.property(\"error\"); pm.expect(j).to.have.property(\"path\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
